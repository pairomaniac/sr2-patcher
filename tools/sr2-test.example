# ~/.sr2-test: where the discs, the installed games and the Wine prefixes
# are on this machine. Read by tools/sr2.sh and tools/check.py; never
# in the repository. Copy to ~/.sr2-test and fill in. One line per
# build: EU, US, AU, JP (Sega's disc) and JP_MK (the DigiCube and
# MediaKite reissue). Leave out a build you do not have; a variable left
# empty shows as N/A.

# The install disc dumps, for tools/sr2.sh install, the cabinet check and tools/kit.py.
SR2_DISC_EU=$HOME/dumps/Sega_Rally_2-Europe-Disc_1-Install_Disc.cue
SR2_DISC_US=$HOME/dumps/Sega_Rally_2-USA-Disc_1-Install_Disc.cue
SR2_DISC_AU=$HOME/dumps/Sega_Rally_2-Australia-Disc_1-Install_Disc.cue
SR2_DISC_JP=$HOME/dumps/Sega_Rally_2-Japan-Disc_1-Install_Disc.cue
SR2_DISC_JP_MK=$HOME/dumps/Sega_Rally_2-Japan-MediaKite-Disc_1-Install_Disc.cue

# The play disc dumps, for tools/sr2.sh rip.
SR2_PLAY_EU=$HOME/dumps/Sega_Rally_2-Europe-Disc_2-Play_Disc.cue
SR2_PLAY_US=$HOME/dumps/Sega_Rally_2-USA-Disc_2-Play_Disc.cue
SR2_PLAY_AU=$HOME/dumps/Sega_Rally_2-Australia-Disc_2-Play_Disc.cue
SR2_PLAY_JP=$HOME/dumps/Sega_Rally_2-Japan-Disc_2-Play_Disc.cue
SR2_PLAY_JP_MK=$HOME/dumps/Sega_Rally_2-Japan-MediaKite-Disc_2-Play_Disc.cue

# The installed games: where tools/sr2.sh installs and runs, what the checks on real files read.
SR2_GAME_EU=$HOME/games/sega-rally-2-eu
SR2_GAME_US=$HOME/games/sega-rally-2-us
SR2_GAME_AU=$HOME/games/sega-rally-2-au
SR2_GAME_JP=
SR2_GAME_JP_MK=

# The Wine prefix to run each in. Faugus keeps them under ~/Faugus/<game>.
# SR2_PFX alone is one prefix for every build.
SR2_PFX_EU=$HOME/Faugus/sega-rally-2-eu
SR2_PFX_US=$HOME/Faugus/sega-rally-2-us
SR2_PFX_AU=$HOME/Faugus/sega-rally-2-au
SR2_PFX_JP=
SR2_PFX_JP_MK=

# How to run: umu with a Proton, or plain wine. Unset, umu-run is taken
# from PATH and the last Proton-CachyOS by name under
# ~/.steam/root/compatibilitytools.d.
SR2_UMU=/usr/bin/umu-run
SR2_PROTON="$HOME/.steam/root/compatibilitytools.d/Proton-CachyOS Latest"
#SR2_WINE=/usr/bin/wine
