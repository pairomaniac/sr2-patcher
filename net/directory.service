# systemd unit for the session directory. tools/directory-install.sh puts this
# in place, with the port substituted into the ExecStart line.
#
# The service needs no home directory, writes nothing and keeps no state, so it
# runs as a DynamicUser with a read-only filesystem. The memory and task caps
# are there because it takes unauthenticated UDP from anywhere.
[Unit]
Description=Sega Rally 2 session directory - UDP 47627
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/sr2-netplay/directory.py 47627

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal

DynamicUser=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProtectControlGroups=true
PrivateDevices=true
RemoveIPC=true
UMask=0077
RestrictAddressFamilies=AF_INET
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
MemoryMax=128M
TasksMax=16

[Install]
WantedBy=multi-user.target
