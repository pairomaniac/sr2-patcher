# PyInstaller writes both of these next to the spec.
build/
dist/

__pycache__/
*.pyc

# Backups the patcher makes beside the game.
*.bak

# tools/sr2.sh writes the game's Wine log here.
logs/

# Game files used by the checks are not in the repository.
game/
data1.cab
data1.head

# The kit for working on the game, written by tools/kit.py: every build's
# installed files minus music and BINDATA (but the lobby's button and IP
# entry art), and data1.head. Beside it the
# update files that Sega released, bundled by hand. Not the repository's
# to distribute.
tools/sr2-kit.tar.gz
tools/sr2-updates.tar.gz
